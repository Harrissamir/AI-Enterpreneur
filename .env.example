# Copy to .env for local runs. Never commit the real file.

# Which AI runs the assistant: "groq" (free tier) or "anthropic" (Claude, prepaid credit).
LLM_PROVIDER=groq

# Groq: free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Claude: key at https://console.anthropic.com (needs prepaid credit)
ANTHROPIC_API_KEY=

# Model for all personas (a persona.json can override). Haiku is the low-cost default;
# claude-sonnet-5-5 gives stronger answers at a higher price per message.
COPILOT_MODEL=claude-haiku-4-5-20251001

# Where every captured lead is POSTed as JSON — e.g. a Zapier "Catch Hook" that emails you
# and appends a Google Sheet row. Leave empty to store leads only in the database.
LEAD_WEBHOOK_URL=

# Long random string. Lets you read leads at GET /v1/leads with "Authorization: Bearer <token>".
ADMIN_TOKEN=

# Cost and abuse controls
DAILY_TOKEN_BUDGET=180000
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_SECONDS=600
MAX_TURNS_PER_SESSION=30

# Extra websites allowed to use every persona (comma-separated), e.g. while testing:
EXTRA_ALLOWED_ORIGINS=http://localhost:8000
